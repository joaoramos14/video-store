{
    "name": "movie-rental-api",
    "version": "1.0.0",
    "description": "API REST em Node.js, TypeScript e Supabase para gerenciar o catalogo de filmes de uma locadora, organizados por gênero.",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "dev": "node --watch --env-file=.env --import=tsx/esm src/server.ts",
        "build": "tsc",
        "start": "node --env-file=.env dist/server.js"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.2.0",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.112.4",
        "express": "^5.2.1"
    }
}