{
    "name": "movie-rental-api",
    "version": "1.0.0",
    "description": "API REST em Node.js, TypeScript e Supabase para gerenciar o catálogo, os clientes e as locações de uma locadora de filmes.",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "dev": "node --watch --env-file=.env --import=tsx/esm src/server.ts",
        "dev:full": "concurrently --kill-others --names api,front --prefix-colors blue,cyan \"npm run dev\" \"npm --prefix frontend run dev\"",
        "build": "tsc",
        "start": "node --env-file=.env dist/server.js",
        "postinstall": "npm --prefix frontend install"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.2.0",
        "concurrently": "^10.0.7",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.112.4",
        "@types/cors": "^2.8.19",
        "@types/supertest": "^7.2.1",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@vitest/coverage-v8": "^5.0.5",
        "cors": "^2.8.5",
        "express": "^5.2.1",
        "supertest": "^7.3.1",
        "swagger-jsdoc": "6.2.8",
        "swagger-ui-express": "^5.0.1",
        "vitest": "^5.0.5"
    }
}
